<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone to Phone"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/peerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Starting direct transfer…"
            android:textColor="#B9C7D9"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/peerRefresh"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Find Phones"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_outline_button" />
            <Button
                android:id="@+id/peerSend"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Send Files"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_send_button" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/peerProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="0" />
        <TextView
            android:id="@+id/peerTransferStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No active transfer"
            android:textColor="#B9C7D9"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nearby PhotoSync phones"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/peerDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_card" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Sent Files"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/peerSentFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_card" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Received Files"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/peerReceivedFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_card" />
        <Button
            android:id="@+id/peerBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_outline_button" />
    </LinearLayout>
</ScrollView>
