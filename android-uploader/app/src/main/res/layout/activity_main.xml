<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHOTOSYNC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />
        <TextView
            android:id="@+id/serverStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Server: Searching LAN…"
            android:textSize="14sp"
            android:paddingBottom="12dp" />
        <Button
            android:id="@+id/findServerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find Server Automatically" />
        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Manual server URL (optional)"
            android:inputType="textUri"
            android:singleLine="true" />
        <Button
            android:id="@+id/saveServerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use / Save Manual Server" />
        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Files" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sent Files"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />
        <LinearLayout
            android:id="@+id/sentFilesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Received Files"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />
        <LinearLayout
            android:id="@+id/receivedFilesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
