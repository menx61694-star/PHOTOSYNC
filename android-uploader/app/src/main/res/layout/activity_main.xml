<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F8FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp" android:background="@drawable/ps_top_header">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="54dp" android:layout_height="54dp" android:gravity="center"
                android:text="◉" android:textColor="#54A5FF" android:textSize="36sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PhotoSync" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Share Anything. Anywhere." android:textColor="#B9C8E5" android:textSize="13sp"/>
            </LinearLayout>
            <com.photosync.uploader.MenuButton android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/ps_menu_light" android:contentDescription="Settings"
                android:padding="12dp" android:src="@android:drawable/ic_menu_manage" android:tint="#243A68"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:background="#F5F8FF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:background="@drawable/ps_connected_card"
                android:gravity="center_vertical" android:padding="14dp">
                <TextView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="10dp" android:background="@drawable/ps_green_dot"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connected"
                        android:textColor="#101827" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/serverStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ready for file transfer" android:textColor="#68748A" android:textSize="12sp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:background="#D9E0EC"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wi-Fi Network"
                        android:textColor="#52607A" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homeServerAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="Waiting for server…" android:textColor="#182238" android:textSize="12sp"
                        android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <TextView android:id="@+id/copyAddressButton" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center"
                    android:text="▣" android:textColor="#315BEA" android:textSize="22sp" android:background="@drawable/ps_small_action"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="14dp"
                android:background="@drawable/ps_light_hero" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRANSFER FILES INSTANTLY"
                    android:textColor="#53638A" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Fast. Private.&#10;No Internet Needed." android:textColor="#111B32" android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Send photos, videos and documents directly over your local network." android:textColor="#5E6C86" android:textSize="11sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                        android:text="🔒&#10;100% Private" android:textColor="#34456B" android:textSize="11sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                        android:text="⚡&#10;High Speed" android:textColor="#34456B" android:textSize="11sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                        android:text="☁&#10;No Cloud" android:textColor="#34456B" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quick Actions"
                    android:textColor="#101827" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:id="@+id/seeAllButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="See All  ›" android:textColor="#315BEA" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="116dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/sendFilesAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp"
                    android:layout_weight="1" android:background="@drawable/ps_action_blue_light" android:gravity="center_vertical"
                    android:padding="12dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="➤"
                        android:textColor="#FFFFFF" android:textSize="27sp" android:background="@drawable/ps_circle_blue"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send Files" android:textColor="#111827" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photos, Videos, Documents&#10;and More" android:textColor="#65718A" android:textSize="10sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#315BEA" android:textSize="28sp"/>
                </LinearLayout>
                <com.photosync.uploader.PeerModeButton android:id="@+id/p2pAction" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/ps_action_green_light"
                    android:gravity="center" android:padding="12dp" android:text="⇄  P2P Transfer&#10;Direct Phone to Phone"
                    android:textAllCaps="false" android:textColor="#11352B" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="112dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.photosync.uploader.TextTransferButton android:id="@+id/textSyncAction" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/ps_action_orange_light" android:gravity="center"
                    android:text="▤  Text Sync&#10;Sync Clipboard Across&#10;Devices" android:textAllCaps="false" android:textColor="#4B2B12" android:textSize="14sp" android:textStyle="bold"/>
                <LinearLayout android:id="@+id/webPinAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp"
                    android:layout_weight="1" android:background="@drawable/ps_action_purple_light" android:gravity="center_vertical"
                    android:padding="12dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="⚿"
                        android:textColor="#FFFFFF" android:textSize="28sp" android:background="@drawable/ps_circle_purple"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web PIN Pairing" android:textColor="#261A50" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share Text &amp; Files&#10;Using PIN" android:textColor="#6D6390" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="196dp" android:layout_marginTop="16dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1"
                    android:background="@drawable/ps_white_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Connected Devices"
                        android:textColor="#17213A" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:background="@drawable/ps_device_row"
                        android:gravity="center_vertical" android:padding="10dp" android:text="▣   This Phone&#10;     ●  This Device" android:textColor="#253451" android:textSize="12sp"/>
                    <TextView android:id="@+id/pcDeviceRow" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="7dp" android:background="@drawable/ps_device_row"
                        android:gravity="center_vertical" android:padding="10dp" android:text="▰   Windows PC&#10;     ●  Waiting for connection" android:textColor="#253451" android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1"
                    android:background="@drawable/ps_white_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦  Scan to Connect"
                        android:textColor="#17213A" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="Open PhotoSync on another device" android:textColor="#69758B" android:textSize="10sp"/>
                    <TextView android:id="@+id/showPinButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="13dp"
                        android:gravity="center" android:text="Pairing PIN&#10;—" android:textColor="#315BEA" android:textSize="15sp" android:textStyle="bold"
                        android:background="@drawable/ps_pin_box" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/pairingPinText" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent Activity"
                    android:textColor="#101827" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:id="@+id/clearHistoryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear All  ▱"
                    android:textColor="#53617A" android:textSize="12sp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <TextView android:id="@+id/sentCard" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                    android:gravity="center" android:text="↑  Sent" android:textColor="#315BEA" android:textSize="11sp" android:background="@drawable/ps_filter_selected"
                    android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/receivedCard" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp"
                    android:gravity="center" android:text="↓  Received" android:textColor="#52607A" android:textSize="11sp" android:background="@drawable/ps_filter"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/sentFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/receivedFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp"/>

            <EditText android:id="@+id/serverUrlInput" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp"
                android:background="@drawable/ps_input_light" android:hint="Manual PC server URL" android:inputType="textUri" android:singleLine="true"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#17213A" android:textColorHint="#8792A7" android:textSize="12sp"/>
            <Button android:id="@+id/selectButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp"
                android:background="@drawable/ps_primary_light" android:text="Send Files  ›" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/statusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <com.photosync.uploader.ServerConnectionControls android:id="@+id/connectionControls" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <com.photosync.uploader.LocalServerInfoView android:id="@+id/localServerInfo" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/ps_bottom_nav" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂&#10;Home" android:textColor="#315BEA" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="□&#10;Files" android:textColor="#46546E" android:textSize="12sp"/>
        <TextView android:id="@+id/bottomSendButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:gravity="center"
            android:text="➤&#10;Send" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/ps_bottom_send"
            android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◷&#10;History" android:textColor="#46546E" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣&#10;Devices" android:textColor="#46546E" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>