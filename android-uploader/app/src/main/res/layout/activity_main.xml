<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F8FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp" android:background="@drawable/ps_top_header">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="54dp" android:layout_height="54dp" android:gravity="center"
                android:text="◉" android:textColor="#54A5FF" android:textSize="36sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PhotoSync" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Share Anything. Anywhere." android:textColor="#B9C8E5" android:textSize="13sp"/>
            </LinearLayout>
            <com.photosync.uploader.MenuButton android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/ps_menu_light" android:contentDescription="Settings"
                android:padding="12dp" android:src="@android:drawable/ic_menu_manage" android:tint="#243A68"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:background="#F5F8FF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:background="@drawable/ps_connected_card"
                android:gravity="center_vertical" android:padding="14dp">
                <TextView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="10dp" android:background="@drawable/ps_green_dot"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connected"
                        android:textColor="#101827" android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/serverStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ready for file transfer" android:textColor="#68748A" android:textSize="12sp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:background="#D9E0EC"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wi-Fi Network"
                        android:textColor="#52607A" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homeServerAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="Waiting for server…" android:textColor="#182238" android:textSize="12sp"
                        android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout android:id="@+id/connectionSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:orientation="vertical" android:background="@drawable/ps_white_card" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connections"
                    android:textColor="#101827" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Choose exactly one connection mode" android:textColor="#68748A" android:textSize="11sp"/>

                <LinearLayout android:id="@+id/embeddedServerSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/ps_action_blue_light" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Embedded Server"
                                android:textColor="#111827" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/embeddedServerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Stopped" android:textColor="#68748A" android:textSize="11sp"/>
                        </LinearLayout>
                        <Button android:id="@+id/startEmbeddedButton" android:layout_width="wrap_content" android:layout_height="42dp"
                            android:background="@drawable/ps_primary_light" android:text="Start" android:textAllCaps="false"
                            android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <Button android:id="@+id/stopEmbeddedButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp"
                            android:background="@drawable/ps_filter" android:text="Stop" android:textAllCaps="false"
                            android:textColor="#26334D" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/embeddedAddressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Web address: unavailable" android:textColor="#42516C" android:textSize="11sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical">
                        <TextView android:id="@+id/showPinButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:gravity="center_vertical" android:paddingStart="12dp" android:text="Pairing PIN: —"
                            android:textColor="#315BEA" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/ps_pin_box"
                            android:clickable="true" android:focusable="true"/>
                        <TextView android:id="@+id/copyAddressButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="7dp"
                            android:gravity="center" android:text="▣" android:textColor="#315BEA" android:textSize="22sp"
                            android:background="@drawable/ps_small_action" android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/otherServersSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/ps_action_purple_light" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other / PC Servers"
                        android:textColor="#261A50" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="Connect to an existing PhotoSync PC server" android:textColor="#6D6390" android:textSize="11sp"/>
                    <TextView android:id="@+id/statusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <com.photosync.uploader.ServerConnectionControls android:id="@+id/connectionControls" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <com.photosync.uploader.LocalServerInfoView android:id="@+id/localServerInfo" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/ps_bottom_nav" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂&#10;Home" android:textColor="#315BEA" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="□&#10;Files" android:textColor="#46546E" android:textSize="12sp"/>
        <TextView android:id="@+id/bottomSendButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:gravity="center"
            android:text="➤&#10;Send" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/ps_bottom_send"
            android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◷&#10;History" android:textColor="#46546E" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣&#10;Devices" android:textColor="#46546E" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>