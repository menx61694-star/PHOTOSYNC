<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F8FF">

    <FrameLayout android:id="@+id/contentFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="0dp" android:background="@drawable/ps_top_header">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:gravity="center_vertical">
                <TextView android:layout_width="54dp" android:layout_height="54dp" android:gravity="center"
                    android:text="◉" android:textColor="#54A5FF" android:textSize="36sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:paddingStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PhotoSync" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Share Anything. Anywhere." android:textColor="#B9C8E5" android:textSize="13sp"/>
                </LinearLayout>
                <com.photosync.uploader.MenuButton android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/ps_menu_light" android:contentDescription="Settings"
                    android:padding="12dp" android:src="@android:drawable/ic_menu_manage" android:tint="#243A68"/>
            </LinearLayout>
        </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:background="@drawable/ps_connected_card"
                android:gravity="center_vertical" android:padding="14dp">
                <TextView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="10dp" android:background="@drawable/ps_green_dot"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection Status"
                        android:textColor="#101827" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/serverStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="No server selected" android:textColor="#68748A" android:textSize="12sp"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:background="#D9E0EC"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Address"
                        android:textColor="#52607A" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homeServerAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="—" android:textColor="#182238" android:textSize="12sp"
                        android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Other / PC Servers" android:textColor="#101827" android:textSize="21sp" android:textStyle="bold"/>
                <LinearLayout android:id="@+id/otherServersSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/ps_action_purple_light" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other / PC Servers"
                        android:textColor="#261A50" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:text="Connect to an existing PhotoSync PC server" android:textColor="#6D6390" android:textSize="11sp"/>
                    <EditText android:id="@+id/serverUrlInput" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp"
                        android:background="@drawable/ps_input_light" android:hint="http://PC-IP:8000" android:inputType="textUri" android:singleLine="true"
                        android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="#17213A" android:textColorHint="#8792A7" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical">
                        <EditText android:id="@+id/serverPinInput" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                            android:background="@drawable/ps_input_light" android:hint="PC server pairing PIN" android:inputType="number" android:maxLength="6"
                            android:singleLine="true" android:paddingStart="12dp" android:paddingEnd="12dp"
                            android:textColor="#17213A" android:textColorHint="#8792A7" android:textSize="12sp"/>
                        <Button android:id="@+id/fetchPinButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="7dp"
                            android:background="@drawable/ps_filter_selected" android:text="Get PIN" android:textAllCaps="false"
                            android:textColor="#FFFFFF" android:textSize="11sp"/>
                        <Button android:id="@+id/refreshPcPinButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="7dp"
                            android:background="@drawable/ps_filter" android:text="Refresh PIN" android:textAllCaps="false"
                            android:textColor="#26334D" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="Enter the PC PIN manually or use Scan QR / Find Server." android:textColor="#6D6390" android:textSize="10sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <Button android:id="@+id/findServerButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="4dp"
                            android:layout_weight="1" android:background="@drawable/ps_primary_light" android:text="Find Server" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <Button android:id="@+id/scanQrButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp"
                            android:layout_weight="1" android:background="@drawable/ps_filter_selected" android:text="Scan QR" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <Button android:id="@+id/saveServerButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp"
                            android:layout_weight="1" android:background="@drawable/ps_primary_light" android:text="Save &amp; Connect" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp">
                        <Button android:id="@+id/connectServerButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="4dp"
                            android:layout_weight="1" android:background="@drawable/ps_filter_selected" android:text="Connect" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <Button android:id="@+id/disconnectServerButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="4dp"
                            android:layout_weight="1" android:background="@drawable/ps_filter" android:text="Disconnect" android:textAllCaps="false" android:textColor="#26334D" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/otherServerStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="Not connected" android:textColor="#5D5578" android:textSize="11sp"/>
                </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="14dp"
                android:background="@drawable/ps_light_hero" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRANSFER FILES INSTANTLY"
                    android:textColor="#53638A" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Fast. Private.&#10;No Internet Needed." android:textColor="#111B32" android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Send photos, videos and documents directly over your local network." android:textColor="#5E6C86" android:textSize="11sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="🔒&#10;100% Private" android:textColor="#34456B" android:textSize="11sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="⚡&#10;High Speed" android:textColor="#34456B" android:textSize="11sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="☁&#10;No Cloud" android:textColor="#34456B" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quick Actions" android:textColor="#101827" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:id="@+id/seeAllButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See All  ›" android:textColor="#315BEA" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="116dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/sendFilesAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1"
                    android:background="@drawable/ps_action_blue_light" android:gravity="center_vertical" android:padding="12dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="➤" android:textColor="#FFFFFF" android:textSize="25sp" android:background="@drawable/ps_circle_blue"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send Files" android:textColor="#111827" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photos, videos &amp; documents" android:textColor="#65718A" android:textSize="10sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#315BEA" android:textSize="26sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/receiveFilesAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1"
                    android:background="@drawable/ps_action_green_light" android:gravity="center_vertical" android:padding="12dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="⇩" android:textColor="#11352B" android:textSize="29sp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Receive Files" android:textColor="#11352B" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="From PC / Web" android:textColor="#4D7066" android:textSize="10sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#267461" android:textSize="26sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="112dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.photosync.uploader.PeerModeButton android:id="@+id/p2pAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1"
                    android:background="@drawable/ps_action_green_light" android:gravity="center" android:padding="12dp" android:text="⇄  P2P Transfer&#10;Direct Phone to Phone"
                    android:textAllCaps="false" android:textColor="#11352B" android:textSize="14sp" android:textStyle="bold"/>
                <com.photosync.uploader.TextTransferButton android:id="@+id/textSyncAction" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1"
                    android:background="@drawable/ps_action_orange_light" android:gravity="center" android:text="▤  Text Sync&#10;Sync Clipboard Across&#10;Devices"
                    android:textAllCaps="false" android:textColor="#4B2B12" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="196dp" android:layout_marginTop="16dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/ps_white_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Connected Devices" android:textColor="#17213A" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:background="@drawable/ps_device_row" android:gravity="center_vertical" android:padding="10dp"
                        android:text="▣   This Phone&#10;     ●  This Device" android:textColor="#253451" android:textSize="12sp"/>
                    <TextView android:id="@+id/pcDeviceRow" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="7dp" android:background="@drawable/ps_device_row" android:gravity="center_vertical" android:padding="10dp"
                        android:text="▰   Windows PC&#10;     ●  Waiting for connection" android:textColor="#253451" android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent Activity" android:textColor="#101827" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:id="@+id/clearHistoryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear All  ▱" android:textColor="#53617A" android:textSize="12sp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <TextView android:id="@+id/sentCard" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center"
                    android:text="↑  Sent" android:textColor="#315BEA" android:textSize="11sp" android:background="@drawable/ps_filter_selected" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/receivedCard" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center"
                    android:text="↓  Received" android:textColor="#52607A" android:textSize="11sp" android:background="@drawable/ps_filter" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/sentFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/receivedFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp"/>

            <TextView android:id="@+id/statusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <TextView android:id="@+id/pairingPinText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <ScrollView android:id="@+id/serverScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:visibility="gone" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:paddingBottom="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Embedded Server" android:textColor="#101827" android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="A dedicated local server page for browser pairing and direct file transfer."
                android:textColor="#68748A" android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Embedded Server" android:textColor="#101827" android:textSize="21sp" android:textStyle="bold"/>
                <LinearLayout android:id="@+id/embeddedServerSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/ps_white_card" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Embedded Server"
                                android:textColor="#111827" android:textSize="17sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/embeddedServerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="Stopped" android:textColor="#68748A" android:textSize="11sp"/>
                        </LinearLayout>
                        <Button android:id="@+id/startEmbeddedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                            android:background="@drawable/ps_primary_light" android:text="Start" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp"/>
                        <Button android:id="@+id/stopEmbeddedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1"
                            android:background="@drawable/ps_filter" android:text="Stop" android:textAllCaps="false" android:textColor="#26334D" android:textSize="12sp"/>
                    </LinearLayout>

                    <TextView android:id="@+id/embeddedAddressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Web address: unavailable" android:textColor="#42516C" android:textSize="12sp"
                        android:maxLines="1" android:ellipsize="end"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                        <TextView android:id="@+id/showPinButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Pairing PIN: —"
                            android:maxLines="1" android:ellipsize="end" android:textColor="#315BEA" android:textSize="13sp" android:textStyle="bold"
                            android:background="@drawable/ps_pin_box" android:clickable="true" android:focusable="true"/>
                        <Button android:id="@+id/webPairingButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="7dp" android:layout_weight="1"
                            android:background="@drawable/ps_filter_selected" android:text="Web Pairing" android:textAllCaps="false"
                            android:textColor="#FFFFFF" android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp">
                        <Button android:id="@+id/refreshPinButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                            android:background="@drawable/ps_filter" android:text="Refresh PIN" android:textAllCaps="false" android:textColor="#26334D" android:textSize="11sp"/>
                        <TextView android:id="@+id/copyAddressButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:layout_weight="1"
                            android:gravity="center" android:text="Copy Address" android:textColor="#315BEA" android:textSize="11sp"
                            android:background="@drawable/ps_small_action" android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:text="File Transfer" android:textColor="#101827" android:textSize="20sp" android:textStyle="bold"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/serverSendFilesButton" android:layout_width="0dp" android:layout_height="50dp"
                        android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/ps_primary_light"
                        android:text="Send Files" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp"/>
                    <Button android:id="@+id/serverReceiveFilesButton" android:layout_width="0dp" android:layout_height="50dp"
                        android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/ps_filter"
                        android:text="Receive Files" android:textAllCaps="false" android:textColor="#26334D" android:textSize="13sp"/>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="Phone → Browser" android:textColor="#17213A" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Files selected with Send Files appear here and are immediately available to paired browsers."
                    android:textColor="#68748A" android:textSize="10sp"/>
                <LinearLayout android:id="@+id/serverSentFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="vertical" android:background="@drawable/ps_white_card" android:padding="8dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:text="Browser / PC → Phone" android:textColor="#17213A" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="Files uploaded from the browser appear here after transfer."
                    android:textColor="#68748A" android:textSize="10sp"/>
                <LinearLayout android:id="@+id/serverReceivedFilesContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="vertical" android:background="@drawable/ps_white_card" android:padding="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/ps_bottom_nav" android:gravity="center_vertical">
        <TextView android:id="@+id/bottomHomeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂&#10;Home" android:textColor="#315BEA" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="□&#10;Files" android:textColor="#46546E" android:textSize="12sp"/>
        <TextView android:id="@+id/bottomSendButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:gravity="center"
            android:text="➤&#10;Send" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/ps_bottom_send" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/bottomServerButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣&#10;Server" android:textColor="#46546E" android:textSize="12sp" android:clickable="true" android:focusable="true"/>
